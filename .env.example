# ── LLM API ──────────────────────────────────────────────────────────────
# Used to score job matches and to auto-answer open-ended application
# questions ("Why do you want to work here?", "Years of experience with X?").
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Site credentials ─────────────────────────────────────────────────────
# NEVER commit your real .env file. Copy this to .env and fill in your own
# values. .env is already git-ignored.

LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your-password

INDEED_EMAIL=you@example.com
INDEED_PASSWORD=your-password

NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=your-password

# ── Optional ─────────────────────────────────────────────────────────────
# Path Playwright should launch a persistent browser profile from, so you
# only have to solve CAPTCHAs / 2FA once per site. Leave blank to use a
# fresh profile each run.
BROWSER_PROFILE_DIR=./data/browser_profile
