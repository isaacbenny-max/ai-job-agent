# ── LLM API (free) ───────────────────────────────────────────────────────
# Used to score job matches and to auto-answer open-ended application
# questions ("Why do you want to work here?", "Years of experience with X?").
#
# Get a free API key (no credit card required) from Google AI Studio:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Site login ───────────────────────────────────────────────────────────
# You do NOT need to fill these in, and you should leave them blank if you
# sign into LinkedIn/Indeed/Naukri with "Continue with Google" or any other
# SSO. Login is manual by design: the first time the agent runs, a real
# browser window opens on each site's login page and pauses for you to log
# in yourself — Google, email/password, 2FA, whatever you actually use.
# After that, the persistent browser profile below remembers the session,
# so you only do this once per site, ever (not once per run).
#
# These fields exist only as an unused fallback for future use; nothing in
# the code currently reads them to auto-fill a login form.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

INDEED_EMAIL=
INDEED_PASSWORD=

NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# ── Browser profile ──────────────────────────────────────────────────────
# Where each site's persistent login session is stored on disk (one
# subfolder per site, created automatically). This directory holds live
# session cookies, so it's already git-ignored — never commit it.
BROWSER_PROFILE_DIR=./data/browser_profile
